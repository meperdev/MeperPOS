{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "prebuild": "dotenv -e .env.production -- npx prisma generate",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "dotenv -e .env.development -- nest start --watch",
    "start:debug": "dotenv -e .env.development -- nest start --debug --watch",
    "start:prod": "npm run migrate:prod && dotenv -e .env.production -- node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "dotenv -e .env.development -- jest",
    "test:watch": "dotenv -e .env.development -- jest --watch",
    "test:cov": "dotenv -e .env.development -- jest --coverage",
    "test:debug": "dotenv -e .env.development -- node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "dotenv -e .env.development -- jest --config ./test/jest-e2e.json",
    "seed": "dotenv -e .env.development -- ts-node prisma/seed.ts",
    "seed:activity": "dotenv -e .env.development -- ts-node prisma/seed-demo-activity.ts",
    "fixtures:receipts": "dotenv -e .env.development -- ts-node test/fixtures/receipts/regenerate-fixtures.ts",
    "fixtures:reports-golden": "dotenv -e .env.development -- ts-node test/fixtures/reports-golden/capture-goldens.ts",
    "fixtures:reports-timing": "dotenv -e .env.development -- ts-node test/fixtures/reports-golden/run-reports-timing.ts",
    "seed:org": "dotenv -e .env.development -- ts-node prisma/seed-org.ts",
    "seed:org:prod": "set SEED_ALLOW_NON_DEV=true&&dotenv -e .env.production -- ts-node prisma/seed-org.ts",
    "backfill:services": "dotenv -e .env.development -- ts-node prisma/backfill-services.ts",
    "backfill:services:prod": "set BACKFILL_ALLOW_PRODUCTION=true&&dotenv -e .env.production -- ts-node prisma/backfill-services.ts",
    "migrate:dev": "dotenv -e .env.development -- npx prisma migrate dev",
    "migrate:prod": "dotenv -e .env.production -- npx prisma migrate deploy",
    "provision:prod": "dotenv -e .env.production -- ts-node prisma/provision.ts",
    "db:up": "bash scripts/db.sh up",
    "db:status": "bash scripts/db.sh status",
    "db:down": "bash scripts/db.sh down",
    "db:logs": "bash scripts/db.sh logs",
    "studio": "dotenv -e .env.development -- npx prisma studio"
  },
  "dependencies": {
    "@fast-csv/format": "^5.0.5",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.12",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.2",
    "@resvg/resvg-js": "2.6.2",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jspdf": "^4.2.1",
    "multer": "^2.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "saxes": "5.0.1",
    "streamifier": "^0.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^10.2.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jspdf": "^1.3.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.20.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "handlebars": "^4.7.10",
    "proxy-addr": "^2.0.8"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^#main-entry-point$": "<rootDir>/../node_modules/.prisma/client/index.js"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
