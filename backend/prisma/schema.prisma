generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String                 @id @default(uuid())
  name               String
  slug               String                 @unique
  taxId              String?
  phone              String?
  address            String?
  settings           Json                   @default("{}")
  settingsVersion    Int                    @default(0)
  active             Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  logoUrl            String?
  status             OrgStatus              @default(TRIAL)
  trialEndsAt        DateTime?
  pastDueAt          DateTime?
  billingStatus      BillingStatus          @default(PENDING)
  plan               PlanType               @default(BASIC)
  auditLogs          AuditLog[]
  cashRegisters      CashRegister[]
  categories         Category[]
  customers          Customer[]
  expenseGroups      ExpenseGroup[]
  expenseLabels      ExpenseLabel[]
  payrollExpenseCategory PayrollExpenseCategory?
  payrollObligationExpenses PayrollObligationExpense[]
  expensePayments    ExpensePayment[]
  expenses           Expense[]
  employees          Employee[]
  employeeShifts     EmployeeShift[]
  payrollObligations PayrollObligation[]
  payrollCashOutflows PayrollCashOutflow[]
  inventoryMovements InventoryMovement[]
  sequences          OrganizationSequence[]
  users              OrganizationUser[]
  payments           Payment[]
  paymentRecords     PaymentRecord[]
  products           Product[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]
  sales              Sale[]
  saleItems          SaleItem[]
  suppliers          Supplier[]
  tasks              Task[]
  taskEvents         TaskEvent[]
  moneyLoans         MoneyLoan[]
  moneyLoanEvents    MoneyLoanEvent[]
  inventoryLoans     InventoryLoan[]
  posLoanSaleIntents PosLoanSaleIntent[]
  posLoanSaleReservations PosLoanSaleReservation[]
  whatsAppConnections WhatsAppConnection[]
  whatsAppConversations WhatsAppConversation[]
  whatsAppInternalContacts WhatsAppInternalContact[]
  whatsAppIdentities WhatsAppIdentity[]
  whatsAppLinkChallenges WhatsAppLinkChallenge[]

  @@index([status, trialEndsAt])
}

// Unexposed payroll foundation; employees do not require login accounts.
enum EmployeeShiftKind {
  FULL_DAY
  PARTIAL_DAY
}

enum EmployeeRemunerationModality {
  FIXED
  BY_DAY
  OTHER
}

model Employee {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  identification String?
  phone          String?
  email          String?
  address        String?
  jobTitle       String?
  startDate      DateTime?       @db.Date
  remunerationModality EmployeeRemunerationModality?
  referenceAmount Decimal?       @db.Decimal(12, 2)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  shifts         EmployeeShift[]
  payrollObligations PayrollObligation[]
  payrollCashOutflows PayrollCashOutflow[]

  @@unique([id, organizationId])
  @@index([organizationId, active])
}

model EmployeeShift {
  id             String            @id @default(uuid())
  organizationId String
  employeeId     String
  date           DateTime          @db.Date
  kind           EmployeeShiftKind
  amount         Decimal           @db.Decimal(12, 2)
  observation    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  employee       Employee          @relation(fields: [employeeId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  payrollMemberships PayrollShiftMembership[]

  @@unique([id, organizationId, employeeId])
  @@unique([organizationId, employeeId, date])
}

// Unwired storage only. Installments, CAS transitions and corrections belong to
// later transactional flows; group totals are not stored here.
enum PayrollObligationKind {
  SHIFT_GROUP
  FIXED_PERIOD
}

enum PayrollObligationStatus {
  PENDING
  COMPLETED
}

model PayrollObligation {
  id             String                  @id @default(uuid())
  organizationId String
  employeeId     String
  kind           PayrollObligationKind
  status         PayrollObligationStatus @default(PENDING)
  version        Int                     @default(0)
  periodStart    DateTime?               @db.Date
  periodEnd      DateTime?               @db.Date
  periodAmount   Decimal?                @db.Decimal
  // Null choice means unspecified, including legacy obligations. Date is explicit only.
  expenseEnabled Boolean?
  selectedExpenseDate DateTime?           @db.Date
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  employee       Employee                @relation(fields: [employeeId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  shiftMemberships PayrollShiftMembership[]
  installments PayrollInstallment[]
  expenseLink PayrollObligationExpense?
  installmentReferences PayrollInstallmentReference[]

  @@unique([id, organizationId, employeeId])
  @@unique([id, organizationId, employeeId, kind])
  @@index([organizationId, employeeId])
}

// releasedAt is only a storage seam, not a complete correction workflow.
// PostgreSQL enforces one unreleased membership per shift with a partial index.
model PayrollShiftMembership {
  id             String                @id @default(uuid())
  organizationId String
  employeeId     String
  shiftId        String
  obligationId   String
  obligationKind PayrollObligationKind @default(SHIFT_GROUP)
  createdAt      DateTime              @default(now())
  releasedAt     DateTime?
  shift          EmployeeShift         @relation(fields: [shiftId, organizationId, employeeId], references: [id, organizationId, employeeId], onDelete: Restrict, onUpdate: Restrict, map: "PayrollShiftMembership_shift_fkey")
  obligation     PayrollObligation     @relation(fields: [obligationId, organizationId, employeeId, obligationKind], references: [id, organizationId, employeeId, kind], onDelete: Restrict, onUpdate: Restrict, map: "PayrollShiftMembership_obligation_fkey")
  allocations    PayrollAllocation[]

  @@unique([id, obligationId, organizationId, employeeId], map: "PayrollShiftMembership_allocation_target_key")
  @@index([obligationId, organizationId, employeeId, obligationKind], map: "PayrollShiftMembership_obligation_idx")
}

// Unwired cash identity and obligation references. Revision evidence is storage
// only; correction workflows are future work. Reports must count outflows.
model PayrollCashOutflow {
  id             String              @id @default(uuid())
  organizationId String
  employeeId     String
  actorId        String
  amount         Decimal             @db.Decimal
  date           DateTime            @db.Date
  method         PaymentMethod
  createdAt      DateTime            @default(now())
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  employee       Employee            @relation(fields: [employeeId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict, map: "PayrollCashOutflow_employee_fkey")
  actor          OrganizationUser    @relation(fields: [actorId, organizationId], references: [userId, organizationId], onDelete: Restrict, onUpdate: Restrict, map: "PayrollCashOutflow_actor_fkey")
  installments   PayrollInstallment[]

  @@unique([id, organizationId, employeeId], map: "PayrollCashOutflow_identity_key")
  @@index([organizationId, date], map: "PayrollCashOutflow_date_idx")
}

model PayrollInstallment {
  id             String             @id @default(uuid())
  organizationId String
  employeeId     String
  obligationId   String
  outflowId      String
  // Registration order inside the obligation, assigned by the grouped writer
  // while it holds the employee -> obligation lock. Nullable on purpose: rows
  // created before this column existed keep NULL because their order was never
  // persisted and must never be inferred; corrections must fail closed on it.
  // Positive and unique per obligation/tenant/employee when set. Fixed-period
  // installments leave it NULL (their revision history is sequenced separately).
  sequence       Int?
  createdAt      DateTime           @default(now())
  obligation     PayrollObligation  @relation(fields: [obligationId, organizationId, employeeId], references: [id, organizationId, employeeId], onDelete: Restrict, onUpdate: Restrict, map: "PayrollInstallment_obligation_fkey")
  outflow        PayrollCashOutflow @relation(fields: [outflowId, organizationId, employeeId], references: [id, organizationId, employeeId], onDelete: Restrict, onUpdate: Restrict, map: "PayrollInstallment_outflow_fkey")
  allocations    PayrollAllocation[]
  revisions      PayrollCashRevision[]
  cashReturn     PayrollCashReturn?
  references     PayrollInstallmentReference[]

  @@unique([id, obligationId, outflowId, organizationId, employeeId], map: "PayrollInstallment_revision_target_key")
  @@unique([id, obligationId, organizationId, employeeId], map: "PayrollInstallment_allocation_target_key")
  @@unique([obligationId, outflowId], map: "PayrollInstallment_obligation_outflow_key")
  @@unique([obligationId, organizationId, employeeId, sequence], map: "PayrollInstallment_obligation_sequence_key")
  @@index([outflowId, organizationId, employeeId], map: "PayrollInstallment_outflow_idx")
}

// Row updates/deletes are rejected; TRUNCATE and privileged operations are not
// guarded. Actor membership cannot be deleted or re-keyed while referenced.
// Writers must validate snapshots, pending status and chain continuity
// transactionally. Multiple revisions per outflow are allowed.
model PayrollCashRevision {
  id             String @id @default(uuid())
  organizationId String
  employeeId     String
  installmentId  String
  obligationId   String
  outflowId      String
  actorId        String
  sequence       Int
  oldAmount      Decimal @db.Decimal
  newAmount      Decimal @db.Decimal
  originalDate   DateTime @db.Date
  originalMethod PaymentMethod
  createdAt      DateTime @default(now())
  installment    PayrollInstallment @relation(fields: [installmentId, obligationId, outflowId, organizationId, employeeId], references: [id, obligationId, outflowId, organizationId, employeeId], onDelete: Restrict, onUpdate: Restrict, map: "PayrollCashRevision_installment_fkey")
  actor          OrganizationUser @relation(fields: [actorId, organizationId], references: [userId, organizationId], onDelete: Restrict, onUpdate: Restrict, map: "PayrollCashRevision_actor_fkey")

  @@unique([installmentId, sequence], map: "PayrollCashRevision_installment_sequence_key")
  @@index([installmentId, obligationId, outflowId, organizationId, employeeId], map: "PayrollCashRevision_installment_idx")
}

// Actual full reimbursement of cash the employee had already received. It is a
// separate append-only fact, not an in-place revision: the original payment,
// its outflow, its allocations and its linked expense stay unchanged, and
// reports must count this return on its own date. Row updates/deletes are
// rejected; TRUNCATE and privileged operations are not guarded. Actor
// membership cannot be deleted or re-keyed while referenced. One return covers
// exactly one complete installment of the completed payment (never an
// obligation-level total), and a second return of the same installment is
// refused because the composite key below fixes its identity, so repeated
// returns cannot be stored. The amount itself is not CHECKed against the
// outflow, so a full return stays a writer rule: nothing is recomputed here and
// the writer must verify amount and the original* snapshot against the returned
// cash outflow. returnMethod is the real method chosen by the actor for the
// money coming back; it is required and independent from originalMethod.
model PayrollCashReturn {
  id             String        @id @default(uuid())
  organizationId String
  employeeId     String
  installmentId  String
  obligationId   String
  outflowId      String
  actorId        String
  amount         Decimal       @db.Decimal
  originalAmount Decimal       @db.Decimal
  originalDate   DateTime      @db.Date
  originalMethod PaymentMethod
  returnMethod   PaymentMethod
  returnDate     DateTime      @db.Date
  createdAt      DateTime      @default(now())
  installment    PayrollInstallment @relation(fields: [installmentId, obligationId, outflowId, organizationId, employeeId], references: [id, obligationId, outflowId, organizationId, employeeId], onDelete: Restrict, onUpdate: Restrict, map: "PayrollCashReturn_installment_fkey")
  actor          OrganizationUser   @relation(fields: [actorId, organizationId], references: [userId, organizationId], onDelete: Restrict, onUpdate: Restrict, map: "PayrollCashReturn_actor_fkey")

  @@unique([installmentId, obligationId, outflowId, organizationId, employeeId], map: "PayrollCashReturn_installment_key")
  @@index([organizationId, returnDate], map: "PayrollCashReturn_date_idx")
}

// Reference-based replacement of a completed payroll payment (L327, L338): a new
// pending payment counts the valid installments of the completed one as already
// paid cash without creating any new cash outflow. This row is the evidence of
// that shared cash: it snapshots the source installment's amount and pins both
// the new payment and the source installment identity (with its owning payment,
// tenant and employee) through composite RESTRICT foreign keys, so neither can be
// re-keyed or deleted while the reference exists. Rows are append-only; ordinary
// UPDATE and DELETE are rejected by trigger, while TRUNCATE and privileged bypass
// are not guarded. Uniqueness per (target payment, source installment) keeps one
// reference per counted installment, and the writer refuses a source installment
// that any other payment already references, so the same cash cannot be counted
// twice. The snapshot is not CHECKed against the source outflow, so comparing it
// with the live cash amount stays a writer/reader rule.
model PayrollInstallmentReference {
  id                  String   @id @default(uuid())
  organizationId      String
  employeeId          String
  targetObligationId  String
  sourceObligationId  String
  sourceInstallmentId String
  amount              Decimal  @db.Decimal
  createdAt           DateTime @default(now())
  targetObligation    PayrollObligation  @relation(fields: [targetObligationId, organizationId, employeeId], references: [id, organizationId, employeeId], onDelete: Restrict, onUpdate: Restrict, map: "PayrollInstallmentReference_target_fkey")
  sourceInstallment   PayrollInstallment @relation(fields: [sourceInstallmentId, sourceObligationId, organizationId, employeeId], references: [id, obligationId, organizationId, employeeId], onDelete: Restrict, onUpdate: Restrict, map: "PayrollInstallmentReference_source_fkey")

  @@unique([targetObligationId, sourceInstallmentId], map: "PayrollInstallmentReference_target_source_key")
  @@index([sourceInstallmentId, organizationId, employeeId], map: "PayrollInstallmentReference_source_idx")
}

// Immutable application evidence; voids and replacements require a future transaction protocol.
model PayrollAllocation {
  id             String @id @default(uuid())
  organizationId String
  employeeId     String
  obligationId   String
  installmentId  String
  membershipId   String
  amount         Decimal @db.Decimal
  createdAt      DateTime @default(now())
  installment    PayrollInstallment @relation(fields: [installmentId, obligationId, organizationId, employeeId], references: [id, obligationId, organizationId, employeeId], onDelete: Restrict, onUpdate: Restrict, map: "PayrollAllocation_installment_fkey")
  membership     PayrollShiftMembership @relation(fields: [membershipId, obligationId, organizationId, employeeId], references: [id, obligationId, organizationId, employeeId], onDelete: Restrict, onUpdate: Restrict, map: "PayrollAllocation_membership_fkey")
  voids          PayrollAllocationVoid[]

  @@unique([id, obligationId, organizationId, employeeId], map: "PayrollAllocation_void_target_key")
  @@index([installmentId, membershipId], map: "PayrollAllocation_installment_membership_idx")
  @@index([membershipId, obligationId, organizationId, employeeId], map: "PayrollAllocation_membership_idx")
}

// A void is immutable evidence, not an automated correction or actor audit.
model PayrollAllocationVoid {
  id             String @id @default(uuid())
  allocationId   String
  obligationId   String
  organizationId String
  employeeId     String
  createdAt      DateTime @default(now())
  allocation     PayrollAllocation @relation(fields: [allocationId, obligationId, organizationId, employeeId], references: [id, obligationId, organizationId, employeeId], onDelete: Restrict, onUpdate: Restrict, map: "PayrollAllocationVoid_allocation_fkey")

  @@unique([allocationId], map: "PayrollAllocationVoid_allocation_key")
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  password           String
  name               String
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tokenVersion       Int                 @default(0)
  isSuperAdmin       Boolean             @default(false)
  auditLogs          AuditLog[]
  expensesCreated    Expense[]           @relation("ExpenseCreatedBy")
  inventoryMovements InventoryMovement[]
  organizationUsers  OrganizationUser[]
  purchaseOrders     PurchaseOrder[]
  refreshTokens      RefreshToken[]
  whatsAppInternalContacts WhatsAppInternalContact[]
  whatsAppIdentities WhatsAppIdentity[]
  whatsAppLinkChallenges WhatsAppLinkChallenge[]
  sales              Sale[]
  tasksAssigned      Task[]              @relation("TaskAssignedTo")
  tasksCreated       Task[]              @relation("TaskCreatedBy")
  taskEvents         TaskEvent[]         @relation("TaskEventCreatedBy")
  posLoanSaleIntentsInitiated PosLoanSaleIntent[] @relation("PosLoanSaleInitiatedBy")
  posLoanSaleReservationsFinalized PosLoanSaleReservation[] @relation("PosLoanSaleReservationFinalizedBy")
  moneyLoansCreated  MoneyLoan[]         @relation("MoneyLoanCreatedBy")
  moneyLoansEmployee MoneyLoan[]         @relation("MoneyLoanEmployee")
  moneyLoanEvents    MoneyLoanEvent[]    @relation("MoneyLoanEventCreatedBy")
  inventoryLoansCreated InventoryLoan[] @relation("InventoryLoanCreatedBy")
  inventoryLoanEvents InventoryLoanEvent[] @relation("InventoryLoanEventCreatedBy")
}

model OrganizationUser {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           OrgRole      @default(MEMBER)
  joinedAt       DateTime     @default(now())
  invitedById    String?
  isPrimaryOwner Boolean      @default(false)
  inventoryLoansEmployee InventoryLoan[] @relation("InventoryLoanEmployee")
  inventoryLoanOperations InventoryLoanOperation[]
  payrollCashOutflows PayrollCashOutflow[]
  payrollCashRevisions PayrollCashRevision[]
  payrollCashReturns PayrollCashReturn[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model RefreshToken {
  id             String    @id @default(uuid())
  token          String    @unique
  userId         String
  organizationId String?
  expiresAt      DateTime
  revokedAt      DateTime?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([organizationId])
}

model OrganizationSequence {
  id             String       @id @default(uuid())
  organizationId String
  type           String
  prefix         String?
  currentNumber  Int          @default(0)
  year           Int?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type, year])
  @@index([organizationId])
}

model CashRegister {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  isDefault      Boolean      @default(false)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Category {
  id             String       @id @default(uuid())
  name           String
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  defaultTaxRate Decimal?     @db.Decimal(5, 2)
  taxable        Boolean      @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model Product {
  id                  String              @id @default(uuid())
  name                String
  sku                 String
  barcode             String?
  description         String?
  costPrice           Decimal             @db.Decimal(10, 2)
  salePrice           Decimal             @db.Decimal(10, 2)
  taxRate             Decimal             @default(0) @db.Decimal(5, 2)
  taxable             Boolean             @default(false)
  stock               Int                 @default(0)
  reservedStock       Int                 @default(0)
  minStock            Int                 @default(0)
  type                ProductType         @default(PRODUCT)
  tracksStock         Boolean             @default(true)
  imageUrl            String?
  categoryId          String
  active              Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  version             Int                 @default(0)
  promotionType       PromotionType?
  promotionValue      Decimal?            @db.Decimal(10, 2)
  preferredSupplierId String?
  organizationId      String
  movements           InventoryMovement[]
  category            Category            @relation(fields: [categoryId], references: [id])
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  preferredSupplier   Supplier?           @relation("PreferredSupplier", fields: [preferredSupplierId], references: [id])
  purchaseItems       PurchaseOrderItem[]
  saleItems           SaleItem[]
  inventoryLoanItems  InventoryLoanItem[]
  posLoanSaleReservations PosLoanSaleReservation[]

  @@unique([id, organizationId])
  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, active])
  @@index([organizationId, categoryId])
  @@index([organizationId, type])
  @@index([organizationId, tracksStock])
}

model InventoryMovement {
  id             String       @id @default(uuid())
  productId      String
  type           MovementType
  quantity       Int
  previousStock  Int
  newStock       Int
  reason         String
  userId         String?
  saleId         String?
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id])
  sale           Sale?        @relation(fields: [saleId], references: [id])
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  inventoryLoanEventId String? @unique
  inventoryLoanEvent InventoryLoanEvent? @relation(fields: [inventoryLoanEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, productId, createdAt])
}

model Customer {
  id             String          @id @default(uuid())
  name           String
  documentType   String
  documentNumber String
  email          String?
  phone          String?
  referencia     String?
  placaMoto      String?
  address        String?
  segment        CustomerSegment @default(OCCASIONAL)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales          Sale[]
  moneyLoans     MoneyLoan[]
  inventoryLoans InventoryLoan[]
  posLoanSaleIntents PosLoanSaleIntent[]
  whatsAppConversations WhatsAppConversation[]

  @@unique([id, organizationId])
  @@unique([organizationId, documentNumber])
  @@index([organizationId, active])
  @@index([organizationId, segment])
}

model Sale {
  id                 String              @id @default(uuid())
  saleNumber         Int
  customerId         String?
  subtotal           Decimal             @db.Decimal(10, 2)
  taxAmount          Decimal             @db.Decimal(10, 2)
  discountAmount     Decimal             @default(0) @db.Decimal(10, 2)
  total              Decimal             @db.Decimal(10, 2)
  amountPaid         Decimal             @db.Decimal(10, 2)
  change             Decimal?            @db.Decimal(10, 2)
  status             SaleStatus          @default(COMPLETED)
  userId             String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  cancelReason       String?
  cancelledAt        DateTime?
  cancelledById      String?
  organizationId     String
  inventoryMovements InventoryMovement[]
  payments           Payment[]
  customer           Customer?           @relation(fields: [customerId], references: [id])
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  items              SaleItem[]
  posLoanSaleIntent  PosLoanSaleIntent?

  @@unique([id, organizationId, customerId])
  @@unique([organizationId, saleNumber])
  @@index([organizationId, createdAt, status])
  @@index([organizationId, userId])
  @@index([organizationId, customerId])
}

model Payment {
  id             String        @id @default(uuid())
  saleId         String
  method         PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  createdAt      DateTime      @default(now())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale           Sale          @relation(fields: [saleId], references: [id])

  @@index([organizationId, saleId])
}

model SaleItem {
  id             String       @id @default(uuid())
  saleId         String
  productId      String
  quantity       Int
  unitPrice      Decimal      @db.Decimal(10, 2)
  costPriceSnapshot Decimal?  @db.Decimal(10, 2)
  taxRate        Decimal      @db.Decimal(5, 2)
  discountAmount Decimal      @default(0) @db.Decimal(10, 2)
  subtotal       Decimal      @db.Decimal(10, 2)
  total          Decimal      @db.Decimal(10, 2)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id])
  sale           Sale         @relation(fields: [saleId], references: [id])

  @@index([organizationId, saleId])
  @@index([organizationId, productId])
}

model Task {
  id             String       @id @default(uuid())
  title          String
  description    String?
  status         TaskStatus   @default(PENDING)
  createdById    String
  assignedToId   String?
  dueDate        DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  assignedTo     User?        @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdBy      User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
