generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String                 @id @default(uuid())
  name               String
  slug               String                 @unique
  taxId              String?
  phone              String?
  address            String?
  settings           Json                   @default("{}")
  settingsVersion    Int                    @default(0)
  active             Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  logoUrl            String?
  status             OrgStatus              @default(TRIAL)
  trialEndsAt        DateTime?
  pastDueAt          DateTime?
  billingStatus      BillingStatus          @default(PENDING)
  plan               PlanType               @default(BASIC)
  auditLogs          AuditLog[]
  cashRegisters      CashRegister[]
  categories         Category[]
  customers          Customer[]
  expenseGroups      ExpenseGroup[]
  expenseLabels      ExpenseLabel[]
  expensePayments    ExpensePayment[]
  expenses           Expense[]
  inventoryMovements InventoryMovement[]
  sequences          OrganizationSequence[]
  users              OrganizationUser[]
  payments           Payment[]
  paymentRecords     PaymentRecord[]
  products           Product[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]
  sales              Sale[]
  saleItems          SaleItem[]
  suppliers          Supplier[]
  tasks              Task[]
  taskEvents         TaskEvent[]
  moneyLoans         MoneyLoan[]
  moneyLoanEvents    MoneyLoanEvent[]
  inventoryLoans     InventoryLoan[]
  posLoanSaleIntents PosLoanSaleIntent[]
  posLoanSaleReservations PosLoanSaleReservation[]

  @@index([status, trialEndsAt])
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  password           String
  name               String
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tokenVersion       Int                 @default(0)
  isSuperAdmin       Boolean             @default(false)
  auditLogs          AuditLog[]
  expensesCreated    Expense[]           @relation("ExpenseCreatedBy")
  inventoryMovements InventoryMovement[]
  organizationUsers  OrganizationUser[]
  purchaseOrders     PurchaseOrder[]
  refreshTokens      RefreshToken[]
  sales              Sale[]
  tasksAssigned      Task[]              @relation("TaskAssignedTo")
  tasksCreated       Task[]              @relation("TaskCreatedBy")
  taskEvents         TaskEvent[]         @relation("TaskEventCreatedBy")
  posLoanSaleIntentsInitiated PosLoanSaleIntent[] @relation("PosLoanSaleInitiatedBy")
  posLoanSaleReservationsFinalized PosLoanSaleReservation[] @relation("PosLoanSaleReservationFinalizedBy")
  moneyLoansCreated  MoneyLoan[]         @relation("MoneyLoanCreatedBy")
  moneyLoansEmployee MoneyLoan[]         @relation("MoneyLoanEmployee")
  moneyLoanEvents    MoneyLoanEvent[]    @relation("MoneyLoanEventCreatedBy")
  inventoryLoansCreated InventoryLoan[] @relation("InventoryLoanCreatedBy")
  inventoryLoanEvents InventoryLoanEvent[] @relation("InventoryLoanEventCreatedBy")
}

model OrganizationUser {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           OrgRole      @default(MEMBER)
  joinedAt       DateTime     @default(now())
  invitedById    String?
  isPrimaryOwner Boolean      @default(false)
  inventoryLoansEmployee InventoryLoan[] @relation("InventoryLoanEmployee")
  inventoryLoanOperations InventoryLoanOperation[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model RefreshToken {
  id             String    @id @default(uuid())
  token          String    @unique
  userId         String
  organizationId String?
  expiresAt      DateTime
  revokedAt      DateTime?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([organizationId])
}

model OrganizationSequence {
  id             String       @id @default(uuid())
  organizationId String
  type           String
  prefix         String?
  currentNumber  Int          @default(0)
  year           Int?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type, year])
  @@index([organizationId])
}

model CashRegister {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  isDefault      Boolean      @default(false)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Category {
  id             String       @id @default(uuid())
  name           String
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  defaultTaxRate Decimal?     @db.Decimal(5, 2)
  taxable        Boolean      @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model Product {
  id                  String              @id @default(uuid())
  name                String
  sku                 String
  barcode             String?
  description         String?
  costPrice           Decimal             @db.Decimal(10, 2)
  salePrice           Decimal             @db.Decimal(10, 2)
  taxRate             Decimal             @default(0) @db.Decimal(5, 2)
  taxable             Boolean             @default(false)
  stock               Int                 @default(0)
  reservedStock       Int                 @default(0)
  minStock            Int                 @default(0)
  type                ProductType         @default(PRODUCT)
  tracksStock         Boolean             @default(true)
  imageUrl            String?
  categoryId          String
  active              Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  version             Int                 @default(0)
  promotionType       PromotionType?
  promotionValue      Decimal?            @db.Decimal(10, 2)
  preferredSupplierId String?
  organizationId      String
  movements           InventoryMovement[]
  category            Category            @relation(fields: [categoryId], references: [id])
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  preferredSupplier   Supplier?           @relation("PreferredSupplier", fields: [preferredSupplierId], references: [id])
  purchaseItems       PurchaseOrderItem[]
  saleItems           SaleItem[]
  inventoryLoanItems  InventoryLoanItem[]
  posLoanSaleReservations PosLoanSaleReservation[]

  @@unique([id, organizationId])
  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, active])
  @@index([organizationId, categoryId])
  @@index([organizationId, type])
  @@index([organizationId, tracksStock])
}

model InventoryMovement {
  id             String       @id @default(uuid())
  productId      String
  type           MovementType
  quantity       Int
  previousStock  Int
  newStock       Int
  reason         String
  userId         String?
  saleId         String?
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id])
  sale           Sale?        @relation(fields: [saleId], references: [id])
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  inventoryLoanEventId String? @unique
  inventoryLoanEvent InventoryLoanEvent? @relation(fields: [inventoryLoanEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, productId, createdAt])
}

model Customer {
  id             String          @id @default(uuid())
  name           String
  documentType   String
  documentNumber String
  email          String?
  phone          String?
  referencia     String?
  placaMoto      String?
  address        String?
  segment        CustomerSegment @default(OCCASIONAL)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales          Sale[]
  moneyLoans     MoneyLoan[]
  inventoryLoans InventoryLoan[]
  posLoanSaleIntents PosLoanSaleIntent[]

  @@unique([id, organizationId])
  @@unique([organizationId, documentNumber])
  @@index([organizationId, active])
  @@index([organizationId, segment])
}

model Sale {
  id                 String              @id @default(uuid())
  saleNumber         Int
  customerId         String?
  subtotal           Decimal             @db.Decimal(10, 2)
  taxAmount          Decimal             @db.Decimal(10, 2)
  discountAmount     Decimal             @default(0) @db.Decimal(10, 2)
  total              Decimal             @db.Decimal(10, 2)
  amountPaid         Decimal             @db.Decimal(10, 2)
  change             Decimal?            @db.Decimal(10, 2)
  status             SaleStatus          @default(COMPLETED)
  userId             String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  cancelReason       String?
  cancelledAt        DateTime?
  cancelledById      String?
  organizationId     String
  inventoryMovements InventoryMovement[]
  payments           Payment[]
  customer           Customer?           @relation(fields: [customerId], references: [id])
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  items              SaleItem[]
  posLoanSaleIntent  PosLoanSaleIntent?

  @@unique([id, organizationId, customerId])
  @@unique([organizationId, saleNumber])
  @@index([organizationId, createdAt, status])
  @@index([organizationId, userId])
  @@index([organizationId, customerId])
}

model Payment {
  id             String        @id @default(uuid())
  saleId         String
  method         PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  createdAt      DateTime      @default(now())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale           Sale          @relation(fields: [saleId], references: [id])

  @@index([organizationId, saleId])
}

model SaleItem {
  id             String       @id @default(uuid())
  saleId         String
  productId      String
  quantity       Int
  unitPrice      Decimal      @db.Decimal(10, 2)
  costPriceSnapshot Decimal?  @db.Decimal(10, 2)
  taxRate        Decimal      @db.Decimal(5, 2)
  discountAmount Decimal      @default(0) @db.Decimal(10, 2)
  subtotal       Decimal      @db.Decimal(10, 2)
  total          Decimal      @db.Decimal(10, 2)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id])
  sale           Sale         @relation(fields: [saleId], references: [id])

  @@index([organizationId, saleId])
  @@index([organizationId, productId])
}

model Task {
  id             String       @id @default(uuid())
  title          String
  description    String?
  status         TaskStatus   @default(PENDING)
  createdById    String
  assignedToId   String?
  dueDate        DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  assignedTo     User?        @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdBy      User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events         TaskEvent[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, assignedToId, status])
  @@index([organizationId, createdById, updatedAt])
  @@index([organizationId, deletedAt])
}

model TaskEvent {
  id             String        @id @default(uuid())
  taskId         String
  type           TaskEventType
  fromStatus     TaskStatus?
  toStatus       TaskStatus
  note           String?
  createdById    String
  createdAt      DateTime      @default(now())
  organizationId String
  createdBy      User          @relation("TaskEventCreatedBy", fields: [createdById], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task           Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([organizationId, taskId, createdAt])
  @@index([organizationId, createdById, createdAt])
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  documentNumber String
  email          String?
  phone          String?
  address        String?
  contactName    String?
  bank           String?
  accountNumber  String?
  accountType    SupplierAccountType?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organizationId String
  expenses       Expense[]
  moneyLoans     MoneyLoan[]
  inventoryLoans InventoryLoan[]
  preferredBy    Product[]       @relation("PreferredSupplier")
  purchaseOrders PurchaseOrder[]
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, documentNumber])
  @@index([organizationId, active])
  @@index([organizationId, name])
  @@unique([id, organizationId])
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  orderNumber    Int
  supplierId     String
  createdById    String
  status         PurchaseOrderStatus @default(DRAFT)
  subtotal       Decimal             @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal             @default(0) @db.Decimal(12, 2)
  total          Decimal             @default(0) @db.Decimal(12, 2)
  notes          String?
  confirmedAt    DateTime?
  receivedAt     DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organizationId String
  createdBy      User                @relation(fields: [createdById], references: [id])
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  expenses       Expense[]
  items          PurchaseOrderItem[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@index([organizationId, supplierId])
  @@index([organizationId, createdAt])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  qtyOrdered      Int
  qtyReceived     Int           @default(0)
  unitCost        Decimal       @db.Decimal(10, 2)
  taxRate         Decimal       @default(0) @db.Decimal(5, 2)
  subtotal        Decimal       @db.Decimal(12, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(12, 2)
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([organizationId, purchaseOrderId])
  @@index([organizationId, productId])
}

// Monetary MONEY/SERVICE tracking only; collections never create sale Payments.
enum MonetaryLoanType {
  MONEY
  SERVICE
}

model MoneyLoan {
  type           MonetaryLoanType @default(MONEY)
  id             String       @id @default(uuid())
  organizationId String
  amount         Decimal      @db.Decimal(10, 2)
  status         MoneyLoanStatus @default(OPEN)
  version        Int          @default(0)
  issuedAt       DateTime     @db.Date
  dueAt          DateTime?    @db.Date
  reason         String       @db.VarChar(500)
  customerId     String?
  supplierId     String?
  employeeId     String?
  createdById    String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier       Supplier?    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  employee       User?        @relation("MoneyLoanEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy      User         @relation("MoneyLoanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  events         MoneyLoanEvent[]
  posLoanSaleIntent PosLoanSaleIntent?

  @@unique([id, organizationId])
  @@unique([id, organizationId, customerId])
  @@index([organizationId, createdAt, id])
}

// Intent presence is reserved for the future dedicated POS initiation path.
model PosLoanSaleIntent {
  id             String       @id @default(uuid())
  organizationId String
  loanId         String       @unique
  customerId     String
  createdAt      DateTime     @default(now())
  finalSaleId    String?      @unique
  quoteSnapshot  Json?
  agreedCustomerTotal Decimal? @db.Decimal(10, 2)
  initiationRequestKey String? @db.VarChar(100)
  initiationRequestHash String? @db.VarChar(64)
  initiatedById  String?
  initiationResult Json?
  initiatedBy    User?        @relation("PosLoanSaleInitiatedBy", fields: [initiatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reservations   PosLoanSaleReservation[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer       Customer     @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  loan           MoneyLoan    @relation(fields: [loanId, organizationId, customerId], references: [id, organizationId, customerId], onDelete: Restrict, onUpdate: Restrict)
  finalSale      Sale?        @relation(fields: [finalSaleId, organizationId, customerId], references: [id, organizationId, customerId], onDelete: Restrict, onUpdate: Restrict)

  // Composite keys declare the one-to-one relation tuples to Prisma.
  @@unique([loanId, organizationId, customerId])
  @@unique([finalSaleId, organizationId, customerId])
  @@unique([organizationId, initiationRequestKey])
  @@unique([id, organizationId])
}

// SQL freezes ownership and validates insert eligibility and terminal claims.
enum PosLoanSaleReservationState {
  HELD
  CONSUMED
  RELEASED
}

model PosLoanSaleReservation {
  id             String       @id @default(uuid())
  intentId       String
  organizationId String
  productId      String
  quantity       Int
  state          PosLoanSaleReservationState @default(HELD)
  createdAt      DateTime     @default(now())
  finalizedAt    DateTime?
  finalizedById  String?
  intent         PosLoanSaleIntent @relation(fields: [intentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product        Product      @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  finalizedBy    User?        @relation("PosLoanSaleReservationFinalizedBy", fields: [finalizedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([intentId, productId])
}

enum MoneyLoanStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum MoneyLoanEventType {
  CREATED
  COLLECTED
  REVERSED
  CLOSED
  CANCELLED
}

// Append-only enforcement and loan input checks are in the SQL migration.
model MoneyLoanEvent {
  id             String             @id @default(uuid())
  loanId         String
  organizationId String
  type           MoneyLoanEventType
  amount         Decimal?           @db.Decimal(10, 2)
  method         PaymentMethod?
  reversesId     String?            @unique
  requestKey     String?            @db.VarChar(100)
  requestPayload String?
  result         Json?
  reverses       MoneyLoanEvent?    @relation("MoneyLoanReversal", fields: [reversesId, loanId, organizationId], references: [id, loanId, organizationId], onDelete: Restrict)
  reversals      MoneyLoanEvent[]   @relation("MoneyLoanReversal")
  reason         String             @db.VarChar(500)
  createdById    String
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  loan           MoneyLoan          @relation(fields: [loanId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy      User               @relation("MoneyLoanEventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([id, loanId, organizationId])
  @@unique([organizationId, loanId, requestKey])
  @@index([organizationId, loanId, createdAt, id])
}

// Unexposed physical-loan foundation. SQL owns checks and immutable evidence.
enum InventoryLoanStatus {
  OPEN
  CANCELLED
  CLOSED
}

enum InventoryLoanEventType {
  CREATED
  DELIVERED
  RETURNED
  CANCELLED
  CLOSED
}

model InventoryLoan {
  id             String              @id @default(uuid())
  organizationId String
  status         InventoryLoanStatus @default(OPEN)
  version        Int                 @default(0)
  customerId     String?
  supplierId     String?
  employeeId     String?
  createdById    String
  createdAt      DateTime            @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer       Customer? @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  supplier       Supplier? @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  employee       OrganizationUser? @relation("InventoryLoanEmployee", fields: [employeeId, organizationId], references: [userId, organizationId], onDelete: Restrict, onUpdate: Restrict)
  createdBy      User @relation("InventoryLoanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items          InventoryLoanItem[]
  events         InventoryLoanEvent[]
  operations     InventoryLoanOperation[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt, id])
}

model InventoryLoanItem {
  id                String   @id @default(uuid())
  loanId            String
  organizationId    String
  productId         String
  quantity          Int
  deliveredQuantity Int      @default(0)
  returnedQuantity  Int      @default(0)
  cancelledQuantity Int      @default(0)
  createdAt         DateTime @default(now())
  loan              InventoryLoan @relation(fields: [loanId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  product           Product @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  events            InventoryLoanEvent[]

  @@unique([id, loanId, organizationId])
  @@index([organizationId, loanId])
  @@index([organizationId, productId])
}

// Completed immutable replay evidence; no pending operation state.
enum InventoryLoanOperationType {
  CREATE
  DELIVER
  RETURN
  CANCEL
  CLOSE
}

model InventoryLoanOperation {
  id             String                     @id @default(uuid())
  organizationId String
  loanId         String
  actorId        String
  type           InventoryLoanOperationType
  requestKey     String
  requestPayload Json
  resultSnapshot Json
  createdAt      DateTime                   @default(now())
  loan           InventoryLoan @relation(fields: [loanId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  actor          OrganizationUser @relation(fields: [actorId, organizationId], references: [userId, organizationId], onDelete: Restrict, onUpdate: Restrict)
  events         InventoryLoanEvent[]

  @@unique([organizationId, requestKey])
  @@unique([id, loanId, organizationId, actorId], map: "InventoryLoanOperation_event_target_key")
}

model InventoryLoanEvent {
  id             String                 @id @default(uuid())
  loanId         String
  organizationId String
  itemId         String?
  operationId    String?
  type           InventoryLoanEventType
  quantity       Int?
  createdById    String
  createdAt      DateTime               @default(now())
  loan           InventoryLoan @relation(fields: [loanId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  item           InventoryLoanItem? @relation(fields: [itemId, loanId, organizationId], references: [id, loanId, organizationId], onDelete: Restrict, onUpdate: Restrict)
  createdBy      User @relation("InventoryLoanEventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operation      InventoryLoanOperation? @relation(fields: [operationId, loanId, organizationId, createdById], references: [id, loanId, organizationId, actorId], onDelete: Restrict, onUpdate: Restrict, map: "InventoryLoanEvent_operation_fkey")
  movement       InventoryMovement?

  @@index([organizationId, loanId, createdAt, id])
}

model AuditLog {
  id             String       @id @default(uuid())
  userId         String?
  action         String
  resource       String
  resourceId     String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@index([organizationId, resource])
}

model PaymentRecord {
  id             String           @id @default(uuid())
  organizationId String
  amount         Decimal          @db.Decimal(10, 2)
  method         PaymentMethod
  date           DateTime
  status         PaymentRecordStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, date])
}

model ExpenseGroup {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  labels         ExpenseLabel[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model ExpenseLabel {
  id             String       @id @default(uuid())
  organizationId String
  groupId        String
  name           String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group          ExpenseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  expenses       Expense[]

  @@unique([groupId, name])
  @@index([organizationId, active])
}

model Expense {
  id              String              @id @default(uuid())
  organizationId  String
  labelId         String
  supplierId      String?
  purchaseOrderId String?
  description     String?
  date            DateTime
  total           Decimal             @db.Decimal(12, 2)
  status          ExpensePaymentStatus
  receiptUrl      String?
  active          Boolean             @default(true)
  createdById     String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label           ExpenseLabel        @relation(fields: [labelId], references: [id])
  supplier        Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrder   PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  createdBy       User                @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  payments        ExpensePayment[]

  @@index([organizationId, date])
  @@index([organizationId, labelId])
}

model ExpensePayment {
  id             String        @id @default(uuid())
  expenseId      String
  organizationId String
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  date           DateTime
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expense        Expense       @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([organizationId, expenseId])
}

